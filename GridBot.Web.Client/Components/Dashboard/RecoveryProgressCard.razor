@using GridBot.Web.Client.Models
@using MudBlazor

@if (State?.RecoveryPhase is not null and not "None")
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Healing" Class="mr-2" />
                    Recovery Progress
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudChip T="string" Color="Color.Info" Size="Size.Small">@State.RecoveryPhase</MudChip>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            @* Phase Progress Stepper *@
            <div class="recovery-stepper mb-4">
                @for (var phase = 1; phase <= 4; phase++)
                {
                    var isComplete = GetPhaseNumber() > phase;
                    var isCurrent = GetPhaseNumber() == phase;
                    <div class="phase-step @(isComplete ? "complete" : "") @(isCurrent ? "current" : "")">
                        <div class="phase-indicator">
                            @if (isComplete)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                            else
                            {
                                <span>@phase</span>
                            }
                        </div>
                        <MudText Typo="Typo.caption">Phase @phase</MudText>
                    </div>
                    @if (phase < 4)
                    {
                        <div class="phase-connector @(isComplete ? "complete" : "")"></div>
                    }
                }
            </div>

            @* Current Phase Details *@
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.subtitle2">Position Size</MudText>
                            <MudText Typo="Typo.body2">@((State.PositionMultiplier * 100).ToString("F0"))%</MudText>
                        </div>
                        <MudProgressLinear Value="@((double)(State.PositionMultiplier * 100))"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           Rounded="true" />
                    </div>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.subtitle2">Spread Width</MudText>
                            <MudText Typo="Typo.body2">@((State.SpreadMultiplier * 100).ToString("F0"))%</MudText>
                        </div>
                        <MudProgressLinear Value="@(100 / (double)State.SpreadMultiplier)"
                                           Color="Color.Info"
                                           Size="Size.Medium"
                                           Rounded="true" />
                    </div>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @GetPhaseDescription()
            </MudText>
        </MudCardContent>
    </MudCard>
}

<style>
    .recovery-stepper {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .phase-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .phase-indicator {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #757575;
        transition: all 0.3s ease;
    }

    .phase-step.complete .phase-indicator {
        background-color: #4caf50;
        color: white;
    }

    .phase-step.current .phase-indicator {
        background-color: #2196f3;
        color: white;
        box-shadow: 0 0 0 4px rgba(33, 150, 243, 0.3);
    }

    .phase-connector {
        flex: 1;
        height: 2px;
        background-color: #e0e0e0;
        margin: 0 8px;
        min-width: 40px;
        max-width: 80px;
    }

    .phase-connector.complete {
        background-color: #4caf50;
    }
</style>

@code {
    [Parameter]
    public DashboardState? State { get; set; }

    private int GetPhaseNumber() => State?.RecoveryPhase switch
    {
        "Phase1" => 1,
        "Phase2" => 2,
        "Phase3" => 3,
        "Phase4" => 4,
        _ => 0
    };

    private string GetPhaseDescription() => State?.RecoveryPhase switch
    {
        "Phase1" => "Phase 1 (0-15 min): 25% position size, 50% wider spreads, rebalancing disabled",
        "Phase2" => "Phase 2 (15-30 min): 50% position size, 25% wider spreads, rebalancing disabled",
        "Phase3" => "Phase 3 (30-60 min): 75% position size, normal spreads, 50% rebalancing",
        "Phase4" => "Phase 4 (60+ min): Full capacity, validating stability before Active state",
        _ => "Recovery mode active - gradually returning to normal operation"
    };
}
