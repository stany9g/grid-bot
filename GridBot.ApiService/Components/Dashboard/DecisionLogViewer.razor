@using GridBot.ApiService.Services.Logging
@using GridBot.ApiService.Models.Logging
@using MudBlazor
@inject IDecisionCycleLogService LogService
@implements IDisposable

<MudPaper Class="pa-4" Elevation="2">
    @* Header with controls *@
    <div class="d-flex justify-space-between align-center mb-3">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(_isLiveMode ? Icons.Material.Filled.PlayCircle : Icons.Material.Filled.History)"
                     Color="@(_isLiveMode ? Color.Success : Color.Default)" />
            <MudText Typo="Typo.h6">Decision Cycle</MudText>
        </div>
        <div class="d-flex align-center gap-3">
            <MudSwitch T="bool" @bind-Value="_isLiveMode"
                       Label="@(_isLiveMode ? "Live" : "History")"
                       Color="Color.Success"
                       Size="Size.Small" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @LogService.Count entries
            </MudText>
        </div>
    </div>

    @if (_isLiveMode)
    {
        @* LIVE MODE: Single status line showing latest cycle *@
        @if (_latestEntry is not null)
        {
            <div class="d-flex flex-wrap align-center gap-3 pa-2"
                 style="background-color: var(--mud-palette-background-grey); border-radius: 4px;">
                @* Time *@
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.body2">@_latestEntry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</MudText>
                </div>

                @* Price *@
                <div class="d-flex align-center gap-1">
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        <strong>$@_latestEntry.CurrentPrice.ToString("N2")</strong>
                    </MudText>
                </div>

                @* Position *@
                <div class="d-flex align-center gap-1">
                    @switch (_latestEntry.PositionDirection)
                    {
                        case "LONG":
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Color="Color.Success">
                                @(_latestEntry.PositionSize?.ToString("F4") ?? "0")
                            </MudText>
                            break;
                        case "SHORT":
                            <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Color="Color.Error">
                                @(_latestEntry.PositionSize?.ToString("F4") ?? "0")
                            </MudText>
                            break;
                        default:
                            <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Default" Size="Size.Small" />
                            <MudText Typo="Typo.body2">FLAT</MudText>
                            break;
                    }
                </div>

                @* Trend *@
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @_latestEntry.TrendState
                    @if (_latestEntry.TargetSkew != 0 || _latestEntry.ActualSkew != 0)
                    {
                        <span style="font-size: 10px; margin-left: 4px;">
                            (@_latestEntry.ActualSkew.ToString("F0")%/@_latestEntry.TargetSkew.ToString("F0")%)
                        </span>
                    }
                </MudChip>

                @* Grid *@
                <MudText Typo="Typo.body2">
                    Grid: <strong>B:@_latestEntry.ActiveBuyOrders S:@_latestEntry.ActiveSellOrders</strong>
                </MudText>

                @* Risk *@
                <MudChip T="string" Color="@GetRiskColor(_latestEntry.RiskStatus)" Size="Size.Small">
                    @_latestEntry.RiskStatus
                </MudChip>

                @* Block *@
                @if (_latestEntry.BlockStatus != "OK")
                {
                    <MudChip T="string" Color="@GetBlockColor(_latestEntry.BlockStatus)" Size="Size.Small">
                        @_latestEntry.BlockStatus
                    </MudChip>
                }

                @* Capacity *@
                <MudText Typo="Typo.body2" Color="@GetCapacityColor(_latestEntry.Capacity)">
                    Cap: <strong>@_latestEntry.Capacity%</strong>
                </MudText>

                @* Orders *@
                @if (_latestEntry.OrdersPlaced > 0 || _latestEntry.OrdersCancelled > 0)
                {
                    <MudText Typo="Typo.body2">
                        <span style="color: var(--mud-palette-success);">+@_latestEntry.OrdersPlaced</span>/<span style="color: var(--mud-palette-error);">-@_latestEntry.OrdersCancelled</span>
                    </MudText>
                }

                @* Duration *@
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @_latestEntry.DurationMs.ToString("F0")ms
                </MudText>

                @* Moon Bag (if active) *@
                @if (!string.IsNullOrEmpty(_latestEntry.MoonBagStatus))
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">
                        🌙 @_latestEntry.MoonBagStatus
                    </MudChip>
                }
            </div>

            @* Warnings/Actions (if any) *@
            @if (_latestEntry.Warnings.Any() || _latestEntry.ActionsBlocked.Any())
            {
                <div class="mt-2 pa-2" style="border-left: 3px solid var(--mud-palette-warning); background-color: var(--mud-palette-background);">
                    @foreach (var warning in _latestEntry.Warnings)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">⚠️ @warning</MudText>
                    }
                    @foreach (var blocked in _latestEntry.ActionsBlocked)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">🚫 @blocked</MudText>
                    }
                </div>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center pa-4">
                Waiting for first decision cycle...
            </MudText>
        }
    }
    else
    {
        @* HISTORY MODE: Time slider + table *@
        @if (_hasEntries)
        {
            <div class="mb-3">
                <MudSlider T="double" Value="_sliderValue"
                           ValueChanged="OnSliderChanged"
                           Min="0" Max="@_sliderMax" Step="5"
                           Color="Color.Primary"
                           Immediate="false">
                </MudSlider>
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(LogService.OldestEntryTime?.ToLocalTime().ToString("HH:mm:ss") ?? "")
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        <strong>@GetSliderTimeLabel()</strong>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(LogService.NewestEntryTime?.ToLocalTime().ToString("HH:mm:ss") ?? "")
                    </MudText>
                </div>
            </div>

            <div class="log-table-container" style="max-height: 350px; overflow-y: auto;">
                <MudSimpleTable Dense="true" Hover="true" FixedHeader="true">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Time</th>
                            <th style="width: 90px;">Price</th>
                            <th style="width: 110px;">Position</th>
                            <th style="width: 140px;">Trend</th>
                            <th style="width: 60px;">Grid</th>
                            <th style="width: 90px;">Risk</th>
                            <th style="width: 70px;">Block</th>
                            <th style="width: 45px;">Cap</th>
                            <th style="width: 55px;">Ord</th>
                            <th style="width: 45px;">ms</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _displayEntries)
                        {
                            <tr @onclick="() => ToggleExpand(entry.Id)" style="cursor: pointer;">
                                <td><MudText Typo="Typo.caption">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</MudText></td>
                                <td><MudText Typo="Typo.caption">$@entry.CurrentPrice.ToString("N2")</MudText></td>
                                <td>
                                    <div class="d-flex align-center gap-1">
                                        @switch (entry.PositionDirection)
                                        {
                                            case "LONG":
                                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" />
                                                break;
                                            case "SHORT":
                                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" Size="Size.Small" />
                                                break;
                                            default:
                                                <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Default" Size="Size.Small" />
                                                break;
                                        }
                                        <MudText Typo="Typo.caption" Color="@GetPositionColor(entry.PositionDirection)">
                                            @(entry.PositionSize?.ToString("F4") ?? "0")
                                        </MudText>
                                    </div>
                                </td>
                                <td>
                                    <MudText Typo="Typo.caption">@entry.TrendState</MudText>
                                </td>
                                <td><MudText Typo="Typo.caption">B:@entry.ActiveBuyOrders S:@entry.ActiveSellOrders</MudText></td>
                                <td>
                                    <MudChip T="string" Color="@GetRiskColor(entry.RiskStatus)" Size="Size.Small" Style="font-size: 9px; height: 18px;">
                                        @TruncateText(entry.RiskStatus, 10)
                                    </MudChip>
                                </td>
                                <td>
                                    <MudChip T="string" Color="@GetBlockColor(entry.BlockStatus)" Size="Size.Small" Style="font-size: 9px; height: 18px;">
                                        @GetBlockShort(entry.BlockStatus)
                                    </MudChip>
                                </td>
                                <td><MudText Typo="Typo.caption" Color="@GetCapacityColor(entry.Capacity)">@entry.Capacity%</MudText></td>
                                <td>
                                    <MudText Typo="Typo.caption">
                                        <span style="color: var(--mud-palette-success);">+@entry.OrdersPlaced</span>/<span style="color: var(--mud-palette-error);">-@entry.OrdersCancelled</span>
                                    </MudText>
                                </td>
                                <td><MudText Typo="Typo.caption">@entry.DurationMs.ToString("F0")</MudText></td>
                            </tr>
                            @if (_expandedEntryId == entry.Id && (entry.Warnings.Any() || entry.ActionsBlocked.Any() || !string.IsNullOrEmpty(entry.MoonBagStatus)))
                            {
                                <tr>
                                    <td colspan="10" class="pa-2" style="background-color: var(--mud-palette-background-grey);">
                                        @if (entry.Warnings.Any())
                                        {
                                            <div class="mb-1">
                                                @foreach (var warning in entry.Warnings)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Warning">⚠️ @warning</MudText>
                                                }
                                            </div>
                                        }
                                        @if (entry.ActionsBlocked.Any())
                                        {
                                            <div>
                                                @foreach (var blocked in entry.ActionsBlocked)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Error">🚫 @blocked</MudText>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(entry.MoonBagStatus))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Info">🌙 @entry.MoonBagStatus</MudText>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center pa-4">
                No history available yet
            </MudText>
        }
    }
</MudPaper>

@code {
    private DecisionCycleLogEntry? _latestEntry;
    private List<DecisionCycleLogEntry> _displayEntries = [];
    private bool _isLiveMode = true;
    private double _sliderValue;
    private double _sliderMax = 100;
    private Guid? _expandedEntryId;
    private bool _hasEntries => LogService.Count > 0;

    private const int MaxHistoryEntries = 50;
    private const int HistoryWindowSeconds = 30;

    protected override void OnInitialized()
    {
        LogService.EntryAdded += OnEntryAdded;
        RefreshData();
    }

    private void OnEntryAdded(object? sender, DecisionCycleLogEntry entry)
    {
        if (_isLiveMode)
        {
            InvokeAsync(() =>
            {
                _latestEntry = entry;
                StateHasChanged();
            });
        }
    }

    private void RefreshData()
    {
        var entries = LogService.GetEntries().ToList();
        _latestEntry = entries.FirstOrDefault();

        if (!_isLiveMode)
        {
            FilterEntriesBySlider(entries);
        }

        UpdateSliderRange();
    }

    private void UpdateSliderRange()
    {
        var oldest = LogService.OldestEntryTime;
        var newest = LogService.NewestEntryTime;

        if (oldest.HasValue && newest.HasValue)
        {
            var range = newest.Value - oldest.Value;
            _sliderMax = Math.Max(range.TotalSeconds, 5);

            // Position slider at latest when switching to history mode
            if (_sliderValue == 0)
            {
                _sliderValue = _sliderMax;
            }
        }
    }

    private void FilterEntriesBySlider(List<DecisionCycleLogEntry>? entries = null)
    {
        entries ??= LogService.GetEntries().ToList();

        var oldest = LogService.OldestEntryTime;
        if (!oldest.HasValue || !_hasEntries)
        {
            _displayEntries = [];
            return;
        }

        var targetTime = oldest.Value.AddSeconds(_sliderValue);
        var windowStart = targetTime.AddSeconds(-HistoryWindowSeconds);
        var windowEnd = targetTime.AddSeconds(HistoryWindowSeconds);

        _displayEntries = entries
            .Where(e => e.Timestamp >= windowStart && e.Timestamp <= windowEnd)
            .Take(MaxHistoryEntries)
            .ToList();
    }

    private void OnSliderChanged(double value)
    {
        _sliderValue = value;
        FilterEntriesBySlider();
    }

    private string GetSliderTimeLabel()
    {
        var oldest = LogService.OldestEntryTime;
        if (!oldest.HasValue) return "No data";

        var targetTime = oldest.Value.AddSeconds(_sliderValue);
        return targetTime.ToLocalTime().ToString("HH:mm:ss");
    }

    private void ToggleExpand(Guid entryId)
    {
        _expandedEntryId = _expandedEntryId == entryId ? null : entryId;
    }

    private static string TruncateText(string text, int maxLength)
        => text.Length > maxLength ? text[..maxLength] + ".." : text;

    private static string GetBlockShort(string status) => status switch
    {
        "BLOCKED:BUYS" => "BUYS",
        "BLOCKED:SELLS" => "SELLS",
        "BLOCKED:ALL" => "ALL",
        _ => status
    };

    private static Color GetPositionColor(string direction) => direction switch
    {
        "LONG" => Color.Success,
        "SHORT" => Color.Error,
        _ => Color.Default
    };

    private static Color GetRiskColor(string status)
    {
        if (status == "OK") return Color.Success;
        if (status.Contains("Severe") || status.Contains("Extreme") ||
            status.Contains("LOSS_LIMIT") || status.Contains("HALTED"))
            return Color.Error;
        return Color.Warning;
    }

    private static Color GetBlockColor(string status) => status switch
    {
        "OK" => Color.Success,
        "BLOCKED:ALL" => Color.Error,
        _ => Color.Warning
    };

    private static Color GetCapacityColor(int capacity) => capacity switch
    {
        > 75 => Color.Success,
        > 25 => Color.Warning,
        _ => Color.Error
    };

    public void Dispose()
    {
        LogService.EntryAdded -= OnEntryAdded;
    }
}
