@using GridBot.ApiService.Models.Dashboard
@using MudBlazor

<MudCard Elevation="2" Class="h-100">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Class="mr-2" />
                Moon Bag
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudChip T="string" Color="@GetStateColor()" Size="Size.Small" Variant="Variant.Outlined">
                @GetStateDisplayName()
            </MudChip>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <div class="d-flex flex-column gap-3">
            @if (MoonBagInfo?.State is "Inactive" or null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Moon bag protection is inactive. Will activate when position is established.
                </MudText>
            }
            else
            {
                @* Protected Quantity *@
                <div class="d-flex align-center justify-space-between">
                    <MudText Typo="Typo.subtitle2">Protected</MudText>
                    <MudText Typo="Typo.body2">@MoonBagInfo.LockedQuantity.ToString("F6")</MudText>
                </div>

                @* Current Profit *@
                <div class="d-flex align-center justify-space-between">
                    <MudText Typo="Typo.subtitle2">Profit</MudText>
                    <MudText Typo="Typo.body2" Color="@GetProfitColor()">
                        @FormatPercent(MoonBagInfo.CurrentProfitPercent)
                    </MudText>
                </div>

                @* High Watermark *@
                <div class="d-flex align-center justify-space-between">
                    <MudText Typo="Typo.subtitle2">High Watermark</MudText>
                    <MudText Typo="Typo.body2">@FormatPrice(MoonBagInfo.HighWatermarkPrice)</MudText>
                </div>

                @* Trailing Stop *@
                @if (MoonBagInfo.State is "Trailing" or "Triggered")
                {
                    <MudDivider />

                    <div class="d-flex align-center justify-space-between">
                        <MudText Typo="Typo.subtitle2">Trailing Stop</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Warning">
                            @FormatPrice(MoonBagInfo.TrailingStopPrice)
                        </MudText>
                    </div>

                    <div class="d-flex align-center justify-space-between">
                        <MudText Typo="Typo.subtitle2">Stop Distance</MudText>
                        <MudText Typo="Typo.body2">
                            @CalculateStopDistance()
                        </MudText>
                    </div>

                    <div class="d-flex align-center justify-space-between">
                        <MudText Typo="Typo.subtitle2">Tier</MudText>
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                            @MoonBagInfo.CurrentTier
                        </MudChip>
                    </div>
                }

                @* Stop Order Status *@
                @if (MoonBagInfo.HasActiveStopOrder)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Class="mr-1" />
                        Stop order active on exchange
                    </MudAlert>
                }

                @* State Reason *@
                @if (!string.IsNullOrEmpty(MoonBagInfo.StateReason))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @MoonBagInfo.StateReason
                    </MudText>
                }
            }
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public MoonBagInfo? MoonBagInfo { get; set; }

    [Parameter]
    public decimal CurrentPrice { get; set; }

    private Color GetStateColor() => MoonBagInfo?.State switch
    {
        "Inactive" => Color.Default,
        "WarmingUp" => Color.Info,
        "Tracking" => Color.Success,
        "Trailing" => Color.Warning,
        "Triggered" => Color.Error,
        "HoldMode" => Color.Primary,
        "Released" => Color.Success,
        _ => Color.Default
    };

    private string GetStateDisplayName() => MoonBagInfo?.State switch
    {
        "WarmingUp" => "Warming Up",
        "HoldMode" => "Hold Mode",
        _ => MoonBagInfo?.State ?? "Inactive"
    };

    private Color GetProfitColor() => (MoonBagInfo?.CurrentProfitPercent ?? 0) switch
    {
        > 10 => Color.Success,
        > 0 => Color.Success,
        < 0 => Color.Error,
        _ => Color.Default
    };

    private string CalculateStopDistance()
    {
        if (MoonBagInfo is null || MoonBagInfo.HighWatermarkPrice == 0) return "-";

        var distancePercent = (MoonBagInfo.HighWatermarkPrice - MoonBagInfo.TrailingStopPrice) / MoonBagInfo.HighWatermarkPrice * 100;
        return $"-{distancePercent:F1}%";
    }

    private static string FormatPrice(decimal price) => price > 0 ? $"${price:N2}" : "-";
    private static string FormatPercent(decimal percent) => percent >= 0 ? $"+{percent:F2}%" : $"{percent:F2}%";
}
