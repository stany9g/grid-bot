@page "/dashboard"
@page "/"
@using GridBot.ApiService.Components.Dashboard
@using GridBot.ApiService.Models.Dashboard
@using GridBot.ApiService.Services.Dashboard
@using MudBlazor
@inject IDashboardStateService DashboardStateService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>ALTE Grid Bot Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    @* Header *@
    <div class="d-flex justify-space-between align-center mb-4">
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h4">ALTE Grid Bot Dashboard</MudText>
            @if (_state.IsStale)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small">STALE DATA</MudChip>
            }
        </div>
        <div class="d-flex align-center gap-2">
            <MudSwitch T="bool" @bind-Value="_autoRefresh"
                       Label="Auto-refresh"
                       Color="Color.Primary"
                       Size="Size.Small" />
            <MudTooltip Text="Refresh now">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshDashboard"
                               Disabled="_isRefreshing" />
            </MudTooltip>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Updated: @_state.LastUpdated.ToLocalTime().ToString("HH:mm:ss")
            </MudText>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }

    @* Row 1: Trading State, Price & Position, Operational Capacity *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="4">
            <TradingStateCard State="_state" OnRefresh="RefreshDashboard" />
        </MudItem>
        <MudItem xs="12" md="4">
            <PricePositionCard State="_state" />
        </MudItem>
        <MudItem xs="12" md="4">
            <OperationalCapacityCard State="_state" />
        </MudItem>
    </MudGrid>

    @* Row 2: Recovery Progress (conditional) *@
    @if (_state.RecoveryPhase is not null and not "None")
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12">
                <RecoveryProgressCard State="_state" />
            </MudItem>
        </MudGrid>
    }

    @* Row 3: Grid Visualization *@
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <GridVisualization GridState="_state.GridState" CurrentPrice="_state.CurrentPrice" />
        </MudItem>
    </MudGrid>

    @* Row 4: Risk, Trend, Moon Bag *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="4">
            <RiskAssessmentCard RiskInfo="_state.RiskInfo" />
        </MudItem>
        <MudItem xs="12" md="4">
            <TrendIndicatorCard TrendInfo="_state.TrendInfo" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MoonBagStatusCard MoonBagInfo="_state.MoonBagInfo" CurrentPrice="_state.CurrentPrice" />
        </MudItem>
    </MudGrid>

    @* Row 5: Decision Cycle Metrics *@
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <DecisionCycleMetrics CycleInfo="_state.CycleInfo" State="_state" />
        </MudItem>
    </MudGrid>

    @* Row 6: Alerts Panel *@
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <AlertsPanel Alerts="_state.RecentAlerts"
                         OnClearAlerts="ClearAlerts"
                         OnAcknowledgeAlert="AcknowledgeAlert"
                         MaxDisplayed="15" />
        </MudItem>
    </MudGrid>

</MudContainer>

@code {
    private DashboardState _state = DashboardState.Empty;
    private bool _autoRefresh = true;
    private bool _isLoading = true;
    private bool _isRefreshing;

    protected override void OnInitialized()
    {
        // Subscribe to state changes from the singleton provider
        DashboardStateService.StateChanged += OnStateChanged;

        // Get current state (polling happens automatically in the background)
        _state = DashboardStateService.CurrentState;
        _isLoading = false;
    }

    private void OnStateChanged(object? sender, DashboardState newState)
    {
        _state = newState;
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshDashboard()
    {
        if (_isRefreshing) return;

        _isRefreshing = true;
        try
        {
            await DashboardStateService.RefreshAsync();
            Snackbar.Add("Dashboard refreshed", Severity.Success, options => options.VisibleStateDuration = 1000);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Refresh failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private void ClearAlerts()
    {
        DashboardStateService.ClearAlerts();
        Snackbar.Add("Alerts cleared", Severity.Info);
    }

    private void AcknowledgeAlert(Guid alertId)
    {
        DashboardStateService.AcknowledgeAlert(alertId);
    }

    public void Dispose()
    {
        DashboardStateService.StateChanged -= OnStateChanged;
    }
}
