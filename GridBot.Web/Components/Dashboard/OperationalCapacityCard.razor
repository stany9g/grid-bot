@using GridBot.Web.Models
@using MudBlazor

<MudCard Elevation="2" Class="h-100">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" />
                Operational Capacity
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <div class="d-flex flex-column gap-3">
            <div>
                <div class="d-flex align-center justify-space-between mb-1">
                    <MudText Typo="Typo.subtitle2">Capacity</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-bold" Color="@GetCapacityColor()">
                        @(State?.OperationalCapacity ?? 0)%
                    </MudText>
                </div>
                <MudProgressLinear Value="@(State?.OperationalCapacity ?? 0)"
                                   Color="@GetCapacityColor()"
                                   Size="Size.Medium"
                                   Rounded="true" />
            </div>

            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.subtitle2">Position Mult</MudText>
                <MudText Typo="Typo.body2">@((State?.PositionMultiplier ?? 1).ToString("F2"))x</MudText>
            </div>

            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.subtitle2">Spread Mult</MudText>
                <MudText Typo="Typo.body2">@((State?.SpreadMultiplier ?? 1).ToString("F2"))x</MudText>
            </div>

            <MudDivider />

            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.subtitle2">Timeouts</MudText>
                <MudChip T="string"
                         Color="@(State?.ConsecutiveTimeouts > 0 ? Color.Warning : Color.Success)"
                         Size="Size.Small"
                         Variant="Variant.Outlined">
                    @(State?.ConsecutiveTimeouts ?? 0)
                </MudChip>
            </div>
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public DashboardState? State { get; set; }

    private Color GetCapacityColor() => State?.OperationalCapacity switch
    {
        >= 80 => Color.Success,
        >= 50 => Color.Warning,
        _ => Color.Error
    };
}
